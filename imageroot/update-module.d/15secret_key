#
# Give existing instances their own SECRET_KEY in forgejo-data, then
# point Forgejo to it through server.env. server.env is changed only
# once the key file exists, so a failure leaves the instance as it was.
#

import os
import subprocess
import sys
import agent

DATA_VOLUME = "forgejo-data"
KEY_FILE = "custom/conf/secret_key"
SECRET_KEY_URI = "file:/var/lib/gitea/" + KEY_FILE

state_dir = os.environ.get("AGENT_STATE_DIR") or os.path.expanduser("~/.config/state")
install_dir = os.environ.get("AGENT_INSTALL_DIR") or os.path.dirname(state_dir)
server_env = os.path.join(state_dir, "server.env")

def log(msg, level=""):
    print(level + msg, file=sys.stderr, flush=True)

def key_file_ok():
    mp = subprocess.run(["podman", "volume", "inspect", "--format", "{{.Mountpoint}}", DATA_VOLUME],
        capture_output=True, text=True)
    if mp.returncode != 0:
        return False
    path = os.path.join(mp.stdout.strip(), KEY_FILE)
    return subprocess.run(["podman", "unshare", "test", "-s", path]).returncode == 0

if not os.path.exists(server_env):
    log(f"{server_env} not found, module not configured yet: skipping")
    sys.exit(0)

if subprocess.run([os.path.join(install_dir, "bin", "ensure-secret-key")]).returncode != 0 or not key_file_ok():
    log(f"No SECRET_KEY in {DATA_VOLUME}: {server_env} left unchanged", agent.SD_ERR)
    sys.exit(1)

env = agent.read_envfile(server_env)
patch = {
    "FORGEJO__security__SECRET_KEY_URI": SECRET_KEY_URI,
    "FORGEJO__security__SECRET_KEY": "",
}
if all(env.get(k) == v for k, v in patch.items()):
    log(f"{server_env} already points to the SECRET_KEY file")
    sys.exit(0)
env.update(patch)
agent.write_envfile(server_env, env)
log(f"Updated {server_env} with SECRET_KEY_URI")
