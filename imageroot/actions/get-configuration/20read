# Read configuration
#
import os
import sys
import json
import agent
# Prepare return variable
config = {}
# Read current configuration from the environment file
config["host"] = os.getenv("TRAEFIK_HOST","")
config["http2https"] = os.getenv("TRAEFIK_HTTP2HTTPS") == "True"
config["lets_encrypt"] = os.getenv("TRAEFIK_LETS_ENCRYPT") == "True"
# Dump the configuration to stdout
# json.dump(config, fp=sys.stdout)
if os.path.exists("server.env"): 
	data = agent.read_envfile("server.env") 
	config["FORGEJO__server__HTTP_PORT"] = data.get("FORGEJO__server__HTTP_PORT", "3000") 
	config["FORGEJO__server__SSH_DOMAIN"] = data.get("FORGEJO__server__SSH_DOMAIN", "") 
	config["FORGEJO__server__START_SSH_SERVER"] = data.get("FORGEJO__server__START_SSH_SERVER", "true") 
	config["FORGEJO__server__DISABLE_SSH"] = data.get("FORGEJO__server__DISABLE_SSH", "false") 
	config["FORGEJO__security__INSTALL_LOCK"] = data.get("FORGEJO__security__INSTALL_LOCK", "true") 
	config["USER_UID"] = data.get("USER_UID", "1000") 
	config["USER_GID"] = data.get("USER_GID", "1000") 
	config["FORGEJO__server__PROTOCOL"] = data.get("FORGEJO__server__PROTOCOL", "http") 
	config["FORGEJO__server__SSH_PORT"] = data.get("FORGEJO__server__SSH_PORT", "2222") 
	config["FORGEJO__database__DB_TYPE"] = data.get("FORGEJO__database__DB_TYPE", "sqlite3") 
	config["FORGEJO__database__PATH"] = data.get("FORGEJO__database__PATH", "/var/lib/gitea/forgejo.db") 
	config["allow_registration"] = data.get("FORGEJO__service__DISABLE_REGISTRATION", "true") != "true"
	config["admin_username"] = data.get("ADMIN_USERNAME", "forgejo-admin")
	config["admin_email"] = data.get("ADMIN_EMAIL", "")
else: 
	config["FORGEJO__server__SSH_PORT"] = "2222" 
	config["FORGEJO__database__DB_TYPE"] = "sqlite3" 
	config["FORGEJO__database__PATH"] = "/var/lib/gitea/forgejo.db" 
	config["FORGEJO__server__HTTP_PORT"] = "3000" 
	config["FORGEJO__server__SSH_DOMAIN"] = "" 
	config["FORGEJO__server__START_SSH_SERVER"] = "true" 
	config["FORGEJO__server__DISABLE_SSH"] = "false" 
	config["FORGEJO__security__INSTALL_LOCK"] = "true" 
	config["USER_UID"] = "1000" 
	config["USER_GID"] = "1000" 
	config["FORGEJO__server__PROTOCOL"] = "http" 
	config["allow_registration"] = False
	config["admin_username"] = "forgejo-admin"
	config["admin_email"] = ""
 
json.dump(config, fp=sys.stdout)
