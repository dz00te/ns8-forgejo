#
# Opens the public SSH port in the node firewall. Requires node:fwadm
# in org.nethserver.authorizations.
#
import os
import agent

tcp_ports = os.environ.get("TCP_PORTS", "").split(",")
ssh_tcp_port = tcp_ports[1] if len(tcp_ports) > 1 else None

if ssh_tcp_port:
    agent.assert_exp(
        agent.add_public_service(
            os.environ['MODULE_ID'],
            [f"{ssh_tcp_port}/tcp"]
        ),
        "Firewall service configuration has failed"
    )
