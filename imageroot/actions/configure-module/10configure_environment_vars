import json
import sys
import os
import agent

data = json.load(sys.stdin)

# Second reserved port (TCP_PORTS[1]) is the public SSH port.
tcp_ports = os.environ.get("TCP_PORTS", "").split(",")
ssh_tcp_port = tcp_ports[1] if len(tcp_ports) > 1 else os.environ.get("TCP_PORT", "2222")
agent.set_env("SSH_TCP_PORT", ssh_tcp_port)

host = data.get("host", "")

FORGEJO__server__HTTP_PORT = data.get("FORGEJO__server__HTTP_PORT", "3000")
FORGEJO__server__SSH_DOMAIN = data.get("FORGEJO__server__SSH_DOMAIN", host)
FORGEJO__server__START_SSH_SERVER = data.get("FORGEJO__server__START_SSH_SERVER", "true")
FORGEJO__server__DISABLE_SSH = data.get("FORGEJO__server__DISABLE_SSH", "false")
FORGEJO__security__INSTALL_LOCK = data.get("FORGEJO__security__INSTALL_LOCK", "true")
USER_UID = data.get("USER_UID", "1000")
USER_GID = data.get("USER_GID", "1000")
FORGEJO__server__PROTOCOL = data.get("FORGEJO__server__PROTOCOL", "http")
FORGEJO__server__DOMAIN = data.get("FORGEJO__server__DOMAIN", host)
FORGEJO__server__ROOT_URL = data.get("FORGEJO__server__ROOT_URL", f"https://{host}/")

# Registration off by default; toggle "Allow user registration" in UI.
FORGEJO__service__DISABLE_REGISTRATION = "false" if data.get("allow_registration") else "true"

# Persisted (not sensitive) so the UI can show the saved value on reload.
ADMIN_USERNAME = data.get("admin_username") or "forgejo-admin"
if ADMIN_USERNAME.lower() == "admin":
    ADMIN_USERNAME = "forgejo-admin"
ADMIN_EMAIL = data.get("admin_email") or f"admin@{host}"

FORGEJO__server__SSH_PORT = data.get("FORGEJO__server__SSH_PORT", ssh_tcp_port)
FORGEJO_WORK_DIR = data.get("FORGEJO_WORK_DIR", "/data")
FORGEJO__database__DB_TYPE = data.get("FORGEJO__database__DB_TYPE", "sqlite3")
FORGEJO__database__PATH = data.get("FORGEJO__database__PATH", "/data/forgejo.db")

server = {
 "FORGEJO__server__HTTP_PORT" : FORGEJO__server__HTTP_PORT ,
 "FORGEJO__server__SSH_DOMAIN" : FORGEJO__server__SSH_DOMAIN ,
 "FORGEJO__server__START_SSH_SERVER" : FORGEJO__server__START_SSH_SERVER ,
 "FORGEJO__server__DISABLE_SSH" : FORGEJO__server__DISABLE_SSH ,
 "FORGEJO__security__INSTALL_LOCK" : FORGEJO__security__INSTALL_LOCK ,
 "USER_UID" : USER_UID ,
 "USER_GID" : USER_GID ,
 "FORGEJO__server__PROTOCOL" : FORGEJO__server__PROTOCOL ,
 "FORGEJO__server__DOMAIN" : FORGEJO__server__DOMAIN ,
 "FORGEJO__server__ROOT_URL" : FORGEJO__server__ROOT_URL ,
 "FORGEJO__service__DISABLE_REGISTRATION" : FORGEJO__service__DISABLE_REGISTRATION ,
 "ADMIN_USERNAME" : ADMIN_USERNAME ,
 "ADMIN_EMAIL" : ADMIN_EMAIL ,
 "FORGEJO__server__SSH_PORT" : FORGEJO__server__SSH_PORT ,
 "FORGEJO_WORK_DIR" : FORGEJO_WORK_DIR ,
 "FORGEJO__database__DB_TYPE" : FORGEJO__database__DB_TYPE ,
 "FORGEJO__database__PATH" : FORGEJO__database__PATH ,
}
agent.write_envfile("server.env", server)
