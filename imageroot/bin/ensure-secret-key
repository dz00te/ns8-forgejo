#!/usr/bin/env python3

#
# Copyright (C) 2023 Nethesis S.r.l.
# SPDX-License-Identifier: GPL-3.0-or-later
#

#
# Make sure forgejo-data holds the instance SECRET_KEY, read by Forgejo
# through SECRET_KEY_URI. An existing key is never replaced.
# The key is written by a throw-away container of the Forgejo image and
# never leaves it: only its length is logged.
#

import os
import subprocess
import sys
import agent

WORKDIR = "/var/lib/gitea"
DATA_VOLUME = "forgejo-data"
KEY_FILE = "custom/conf/secret_key"

# Runs inside the container as the image user (git, 1000).
# Prints one line: <exists|adopted|generated> len=<n> db=<0|1|->
SCRIPT = r'''
set -e
f="$1/custom/conf/secret_key"
ini="$1/custom/conf/app.ini"
if [ -s "$f" ]; then
    echo "exists len=$(wc -c < "$f") db=-"
    exit 0
fi
[ -f "$1/forgejo.db" ] && db=1 || db=0
umask 077
mkdir -p "${f%/*}"
key=""
if [ -f "$ini" ]; then
    key=$(sed -n '/^\[security\]/,/^\[/{s/^[[:space:]]*SECRET_KEY[[:space:]]*=[[:space:]]*//p}' "$ini" | sed 's/[[:space:]]*$//')
fi
if [ -n "$key" ]; then
    printf '%s' "$key" > "$f.tmp"
    how=adopted
else
    forgejo generate secret SECRET_KEY > "$f.tmp"
    how=generated
fi
if [ ! -s "$f.tmp" ]; then
    rm -f "$f.tmp"
    echo "empty key, nothing written" >&2
    exit 1
fi
mv -f "$f.tmp" "$f"
echo "$how len=$(wc -c < "$f") db=$db"
'''

def log(msg, level=""):
    print(level + msg, file=sys.stderr, flush=True)

def forgejo_image():
    image = os.environ.get("FORGEJO_IMAGE")
    if image:
        return image
    state_dir = os.environ.get("AGENT_STATE_DIR") or os.path.expanduser("~/.config/state")
    return agent.read_envfile(os.path.join(state_dir, "environment")).get("FORGEJO_IMAGE")

def key_file_ok():
    mp = subprocess.run(["podman", "volume", "inspect", "--format", "{{.Mountpoint}}", DATA_VOLUME],
        capture_output=True, text=True)
    if mp.returncode != 0:
        return False
    path = os.path.join(mp.stdout.strip(), KEY_FILE)
    return subprocess.run(["podman", "unshare", "test", "-s", path]).returncode == 0

image = forgejo_image()
if not image:
    log("FORGEJO_IMAGE not set", agent.SD_ERR)
    sys.exit(1)

# label=disable and no :Z: relabeling the whole volume here would cut off
# a running forgejo-app; forgejo-app relabels it with :Z at every start.
proc = subprocess.run([
        "podman", "run", "--rm", "--network=none", "--security-opt=label=disable",
        "--image-volume=ignore", "--volume", f"{DATA_VOLUME}:{WORKDIR}",
        "--entrypoint", "/bin/sh", image, "-c", SCRIPT, "_", WORKDIR,
    ], capture_output=True, text=True)
if proc.stderr.strip():
    log(proc.stderr.strip())
if proc.returncode != 0:
    log(f"SECRET_KEY setup failed (exit {proc.returncode})", agent.SD_ERR)
    sys.exit(1)

result = proc.stdout.strip().splitlines()[-1] if proc.stdout.strip() else ""
log(f"SECRET_KEY {result}")
if result.startswith("generated") and result.endswith("db=1"):
    log("A new SECRET_KEY was generated for existing data: TOTP, Actions secrets, "
        "webhook secrets and mirror credentials encrypted with the old key "
        "can no longer be read and must be set again", agent.SD_WARNING)

if not key_file_ok():
    log(f"{KEY_FILE} missing or empty in {DATA_VOLUME}", agent.SD_ERR)
    sys.exit(1)
